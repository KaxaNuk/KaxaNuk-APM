# What this repository can actually produce, and nothing else.  The stock GitHub Python template
# also covers Django, Flask, Scrapy, Celery, SageMath, PyBuilder and a dozen packaging tools; none
# of them can appear in a repository of APM packages, and a rule nobody can trigger is a rule
# nobody reads.

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Build output
build/
dist/
*.egg-info/
*.egg

# Test and coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.cache

# Linters and type checkers
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# Jupyter
.ipynb_checkpoints

# Environments and secrets
.env
.envrc
.venv
env/
venv/
ENV/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# AI - managed by APM
.agents/
.claude/
apm_modules/
.mcp.json
apm.lock.yaml

# Customizations
.debug/
*-pycharm-support-libs.zip
*-pycharm-support-libs/
